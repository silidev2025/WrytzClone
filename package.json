{
  "name": "craftbase",
  "version": "1.0.0",
  "private": true,
  "description": "Craftbase — a beginner-friendly visual app builder with a drag-and-drop editor and a built-in database.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-regressions.cjs",
    "test:mobile": "node scripts/test-mobile.cjs",
    "mobile:install": "npm --prefix mobile/expo ci",
    "mobile:worker": "node scripts/mobile-worker.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "immer": "^11.1.18",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
