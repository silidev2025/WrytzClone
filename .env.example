# Copy this file to .env.local and fill in what you need.
# NEXT_PUBLIC_… values are built into the site: set them BEFORE `npm run build`.

# ---------------------------------------------------------------- who runs this site
# Shown on the Terms, Privacy and Contact pages. Required before real people sign up.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
# e.g. "DTI Reg. No. …, BIR TIN …" (leave empty if not applicable)
NEXT_PUBLIC_BUSINESS_REGISTRATION=
NEXT_PUBLIC_SUPPORT_EMAIL=
# defaults to the support email
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_DPO_NAME=
# youngest age allowed to sign up (default 18)
NEXT_PUBLIC_MINIMUM_AGE=

# Account ids (from Settings) of the people who may open /operator: reports, takedowns,
# password-reset links. Comma-separated.
OPERATOR_IDS=

# ---------------------------------------------------------------- domain
# Your main domain. Published apps get their own address: https://<app-name>.example.com
# Needs a wildcard DNS record (*.example.com) pointing at your server — see README.md.
# Leave empty and apps live at https://example.com/app/<app-name> instead.
# Local testing: NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000  ->  http://<app-name>.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=
# "https" (default) or "http". Only needed if the automatic guess is wrong.
NEXT_PUBLIC_APP_PROTOCOL=

# Set to 1 when a proxy (Cloudflare, Caddy, Nginx…) sits in front of the app, so rate limits
# and HTTPS detection use the real visitor IP and protocol. Leave empty without a proxy.
TRUST_PROXY=

# ---------------------------------------------------------------- storage
# Postgres connection string (Neon, Supabase, Vercel Postgres, your own server).
# Required on serverless hosts like Vercel. Leave empty to store everything in files.
DATABASE_URL=
# How many database connections to keep open (default 5).
DATABASE_POOL_SIZE=
# Live collaboration across several servers uses Postgres LISTEN, which needs a direct
# connection. Set this when DATABASE_URL goes through a pooler (Neon "-pooler", PgBouncer).
DATABASE_URL_UNPOOLED=

# Where file storage keeps its data when DATABASE_URL is empty (default: ./.data).
# Keep it OUTSIDE cloud-synced folders such as OneDrive or Dropbox: it holds accounts and sessions.
CRAFTBASE_DATA_DIR=
# Where `npm run backup` writes copies (default: ./backups) — keep it private and out of cloud-synced folders.
CRAFTBASE_BACKUP_DIR=
# Backups older than this many days are deleted by `npm run backup` (default 30). State it in your privacy notice.
CRAFTBASE_BACKUP_KEEP_DAYS=

# A long random string (32+ characters) used to sign and hash things on the server (the ids apps
# see for each person, hashed IP addresses in the security log). Set it with Postgres; with file
# storage one is created in the data folder automatically. Changing it gives everyone new ids inside apps.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRAFTBASE_SECRET=

# ---------------------------------------------------------------- email (optional)
# With these set, "Forgot password?" emails a reset link (via https://resend.com).
# Without them, operators create reset links on the /operator page.
RESEND_API_KEY=
MAIL_FROM=

# ---------------------------------------------------------------- mobile testing
# Public HTTPS origin where phones can reach Craftbase. No path or trailing query.
CRAFTBASE_PUBLIC_URL=
# The same random secret (32+ characters) on the web server and mobile worker. Never NEXT_PUBLIC.
CRAFTBASE_MOBILE_WORKER_TOKEN=
# Optional worker-to-server origin; loopback HTTP is allowed. Defaults to CRAFTBASE_PUBLIC_URL.
CRAFTBASE_MOBILE_SERVER_URL=
# Private persistent worker directory for signing keys and temporary builds. Keep out of OneDrive.
# Defaults to ~/.craftbase-mobile. See docs/mobile-deployment.md for setup and retention.
CRAFTBASE_MOBILE_WORK_DIR=
# Android SDK location; the default Android Studio install is detected automatically.
ANDROID_HOME=
# Optional build-tools version, otherwise the newest installed stable version is used.
CRAFTBASE_ANDROID_BUILD_TOOLS=
